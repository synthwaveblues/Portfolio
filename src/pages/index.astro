---
import Layout from '../layouts/layout.astro';
import Hero from '../components/sections/hero.tsx';
import Projects from '../components/sections/projects.tsx';
import TechStack from '../components/sections/techStack';
import Timeline from '../components/sections/timeline.tsx';
import FunZone from "../components/sections/FunZone/FunZone.tsx";
import Contact from "../components/sections/Contact.tsx";
---

<Layout title="Anton Shevchenko - Full-Stack Developer">
  <Hero client:load/>
  <!-- the rest is in the HTML already; their JS loads as each section nears the screen -->
  <Projects client:visible={{rootMargin: '400px'}}/>
  <TechStack client:visible={{rootMargin: '400px'}}/>
  <Timeline client:visible={{rootMargin: '400px'}}/>
  <FunZone client:visible={{rootMargin: '400px'}}/>
  <Contact client:visible={{rootMargin: '400px'}}/>
</Layout>