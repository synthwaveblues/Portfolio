---
import Nav from '../components/ui/Nav';
// self-hosted fonts: no request to Google before the page can paint
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Anton Shevchenko — Full-Stack Developer',
  description = 'Anton Shevchenko — full-stack developer building scalable backends, clean APIs and modern web and mobile apps with TypeScript, Node.js, React and Kotlin.',
} = Astro.props;

const canonical = Astro.url.href;
const ogImage = new URL('/og.png', Astro.url).href;
---

<style is:global>
    @import '../styles/global.css';
</style>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <!-- the two faces the hero uses, fetched alongside the CSS instead of after it -->
  <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin/>
  <link rel="preload" href={spaceGroteskLatin} as="font" type="font/woff2" crossorigin/>

  <!-- Open Graph -->
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:image" content={ogImage}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={ogImage}/>
  <script is:inline>
    (function () {
      var t = localStorage.getItem('theme');
      if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
    })();
    document.documentElement.classList.add('preload');
    // hide the native scrollbar before first paint so the page doesn't shift when the floating one loads
    if (window.matchMedia('(pointer: fine)').matches) document.documentElement.classList.add('custom-scrollbar');
    window.addEventListener('DOMContentLoaded', function () {
      requestAnimationFrame(function () {
        document.documentElement.classList.remove('preload');
      });
    });
  </script>
</head>
<body>
<Nav client:load/>
<main>
  <slot/>
</main>
<script>
  import '../scripts/scrollbar';
</script>
</body>
</html>